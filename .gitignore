# macOS
.DS_Store

# Lean / Lake build artifacts
.lake/
build/
*.olean
*.olean.lock
*.ilean

# Lake dependency lockfile (library: consumers resolve their own deps)
lake-manifest.json

# Nix build output symlinks (`nix build`/`nix run` default to `result`/`result-*`).
result
result-*

# Openspec planning artifacts are tracked; nothing extra to ignore here.

# Scratch Lean probes (`AGENTS.md` — "Scratch work lives in the repo, never in /tmp").
# Tracked paths only; the directory itself is kept by `scratch/.gitkeep`.
scratch/*
!scratch/.gitkeep
